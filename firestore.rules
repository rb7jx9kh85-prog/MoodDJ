rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      allow read: if isOwner();

      allow create: if isOwner()
        && request.resource.data.keys().hasAll([
          "uid",
          "email",
          "displayName",
          "photoURL",
          "plan",
          "selectedPlan",
          "onboardingCompleted",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "photoURL",
          "plan",
          "selectedPlan",
          "onboardingCompleted",
          "createdAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.plan == "free"
        && request.resource.data.selectedPlan == null
        && request.resource.data.onboardingCompleted == false;

      allow update: if isOwner()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "email",
            "displayName",
            "photoURL",
            "selectedPlan",
            "onboardingCompleted",
            "onboardingCompletedAt"
          ])
        && (
          request.resource.data.selectedPlan == "free"
          || request.resource.data.selectedPlan == "starter"
          || request.resource.data.selectedPlan == "creator"
          || request.resource.data.selectedPlan == "unlimited"
        )
        && request.resource.data.onboardingCompleted == true;

      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}