rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write their own profile document.
    // Document ID is the Firebase Auth uid (see lib/firebase-auth.ts).
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // Creation only via the client right after sign-up/sign-in, and only
      // for the caller's own uid, with a locked-down shape so nobody can
      // grant themselves a paid plan by writing an arbitrary document.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.plan == "free";
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
