rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      allow read: if isOwner();

      // Initial profile creation right after sign-up/sign-in. Plan always
      // starts at "free" / unselected — the fake checkout is the only path
      // that can ever change it, and it runs server-side with the Admin SDK
      // (which is not subject to these rules at all).
      allow create: if isOwner()
        && request.resource.data.keys().hasAll([
          "uid",
          "email",
          "displayName",
          "photoURL",
          "plan",
          "selectedPlan",
          "onboardingCompleted",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "photoURL",
          "plan",
          "selectedPlan",
          "onboardingCompleted",
          "createdAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.plan == "free"
        && request.resource.data.selectedPlan == null
        && request.resource.data.onboardingCompleted == false;

      // The browser may only ever touch its own basic profile fields.
      // Plan, selectedPlan, planStatus, onboardingCompleted, quotas, and
      // every checkout/discount/price field are exclusively written by the
      // server (Admin SDK, via /api/checkout/complete and /api/generate),
      // which bypasses these rules entirely — so leaving them out here is
      // what makes them "server-only" in practice.
      allow update: if isOwner()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(["email", "displayName", "photoURL"]);

      allow delete: if false;
    }

    // Referral program — see lib/referral.ts. Every write (code generation,
    // linking, activation, tier-ups, credits) happens exclusively server-side
    // via the Admin SDK, which bypasses these rules entirely. The client only
    // ever reads.
    match /referralProfiles/{uid} {
      allow read: if request.auth != null; // needed for the friends leaderboard to read other profiles
      allow write: if false;
    }

    match /referrals/{referralId} {
      allow read: if request.auth != null
        && (resource.data.referrerUid == request.auth.uid
            || resource.data.refereeUid == request.auth.uid);
      allow write: if false;
    }

    match /rewardLedger/{ledgerId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Playlist history — see lib/playlist-history.ts. Written server-side
    // only, from /api/generate right after a successful generation.
    match /playlistHistory/{entryId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
