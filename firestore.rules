rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      function hasAllowedFields() {
        return request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "photoURL",
          "plan",
          "selectedPlan",
          "onboardingCompleted",
          "onboardingCompletedAt",
          "createdAt"
        ]);
      }

      function hasValidSelectedPlan() {
        return request.resource.data.selectedPlan == "free"
          || request.resource.data.selectedPlan == "starter"
          || request.resource.data.selectedPlan == "creator"
          || request.resource.data.selectedPlan == "unlimited";
      }

      allow read: if isOwner();

      allow create: if isOwner()
        && request.resource.data.uid == userId
        && request.resource.data.plan == "free"
        && request.resource.data.selectedPlan == null
        && request.resource.data.onboardingCompleted == false
        && hasAllowedFields();

      allow update: if isOwner()

        // Interdiction de modifier l’identité du document.
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt

        // Le navigateur ne peut pas activer lui-même un abonnement payant.
        && request.resource.data.plan == resource.data.plan

        // Le choix de plan doit être valide.
        && hasValidSelectedPlan()

        // Le choix du plan termine l’onboarding.
        && request.resource.data.onboardingCompleted == true

        && hasAllowedFields();

      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}