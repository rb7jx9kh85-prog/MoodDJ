# OpenAI — used server-side only to turn a vibe into a structured playlist plan
OPENAI_API_KEY=

# Spotify Developer app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must EXACTLY match a Redirect URI registered in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Long random string (minimum 32 characters) used to sign OAuth state and
# encrypt Spotify tokens stored in HttpOnly cookies. Production refuses to
# start Spotify authentication without it.
COOKIE_SECRET=change-this-long-random-string

# Firebase UID of the one Mood DJ administrator allowed to connect the shared
# public Spotify account from Settings. No Spotify password or token belongs
# in this file: the OAuth refresh token is encrypted server-side in Firestore.
MOODDJ_PUBLISHER_OWNER_UID=

# Firebase project config (https://console.firebase.google.com -> Project settings -> Web app)
# Used client-side for email/password, Google and Apple sign-in + Firestore user profiles.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only) — used to verify ID tokens and enforce plan
# quotas in API routes. Generate at: Firebase console -> Project settings ->
# Service accounts -> Generate new private key. Paste the JSON's fields here
# (keep the \n escapes in the private key literal, they're unescaped at runtime).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Whop (real payments) — https://dashboard.whop.com -> Developer -> API Keys.
# Used server-side only to create checkout sessions for paid plans.
WHOP_API_KEY=

# https://dashboard.whop.com -> Developer -> Webhooks. Used to verify that
# incoming payment.succeeded events actually come from Whop before a plan is
# ever activated (see app/api/webhooks/whop/route.ts).
WHOP_WEBHOOK_SECRET=

# Plan ids from https://dashboard.whop.com -> your product -> Pricing, one per
# paid Mood DJ plan (the free plan needs none — it's activated directly).
WHOP_PLAN_ID_STARTER=
WHOP_PLAN_ID_CREATOR=
WHOP_PLAN_ID_UNLIMITED=
