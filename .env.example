# OpenAI — used server-side only to turn a vibe into a structured playlist plan
OPENAI_API_KEY=

# Spotify Developer app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must EXACTLY match a Redirect URI registered in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Long random string used to sign the OAuth state cookie
COOKIE_SECRET=change-this-long-random-string
